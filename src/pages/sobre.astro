---
import Base from "../layouts/Base.astro";
import Topo from "../components/Topo.astro";
import Foto from "../components/Foto.astro";
import Pendente from "../components/Pendente.astro";
import FaixaCta from "../components/FaixaCta.astro";
import { site, url } from "../lib/site";
---
<Base
  titulo="Sobre o box"
  descricao="O CrossFit Kyosei é um box afiliado CrossFit no Cambuí, em Campinas, aberto em janeiro de 2026. Treino com qualidade, cuidado e comunidade, para todos os níveis."
>
  <Topo
    olho="Sobre"
    titulo="No coração do Cambuí"
    chamada={`O CrossFit Kyosei abriu em ${site.inauguracao}, na General Osório. É um box afiliado CrossFit pensado para quem quer treinar com constância, cuidado e companhia.`}
  />

  <section class="secao">
    <div class="miolo colagem">
      <div class="colagem__fotos">
        <Foto class="colagem__grande" src="/fotos/turma-completa.webp" alt="Turma do Kyosei reunida no box, sorrindo para a foto" proporcao="4 / 5" posicao="50% 58%" carregar="eager" />
        <Foto class="colagem__pequena" src="/fotos/aula-agachamento.webp" alt="Lucas Chiba demonstrando o agachamento para um aluno" proporcao="3 / 4" posicao="50% 72%" />
        <svg class="colagem__flor" aria-hidden="true"><use href="#k-flor" /></svg>
      </div>
      <div class="colagem__texto prosa">
        <p class="olho">Nossa história <Pendente nota="validar texto com os sócios" /></p>
        <h2>Quem planeja o treino está na aula</h2>
        <p class="chamada">O Kyosei nasceu da vontade de ter um box com treino de qualidade e atenção de perto. O head coach e sócio, Lucas Chiba, monta a programação; a coach Stella Mazotti planeja as aulas em cima dela. E são os dois que conduzem as turmas.</p>
        <p>A turma é formada, na maior parte, por gente que quer saúde e disposição, não medalha. Por isso o foco é técnica, segurança e constância, com cada treino adaptado ao momento de cada pessoa.</p>
      </div>
    </div>
  </section>

  <section class="secao secao--areia secao--curva">
    <div class="miolo">
      <div class="socios">
      <figure class="socios__foto">
        <Foto src="/fotos/lucas-familia.webp" alt="Lucas Chiba no box, com uma criança no colo, ao lado de uma mulher que também segura uma criança" proporcao="4 / 5" posicao="50% 45%" />
        <figcaption><Pendente nota="quem aparece e autorização de imagem das crianças" /></figcaption>
      </figure>
      <div>
      <div class="cabeca-secao"><div><p class="olho">Time</p><h2>Quem está por trás</h2></div></div>
      <div class="grade">
        <article class="cartao">
          <h3>Lucas Chiba</h3>
          <p>Sócio e head coach, CrossFit Level 3. Cuida da programação e está nas aulas.</p>
          <a class="link-seta" href={url("/coaches#lucas-chiba")}>Ver perfil</a>
        </article>
        <article class="cartao">
          <h3>Stella Mazotti</h3>
          <p>Coach, CrossFit Level 1. Parceira do Lucas nas programações, planeja as aulas e conduz metade delas.</p>
          <a class="link-seta" href={url("/coaches#stella-mazotti")}>Ver perfil</a>
        </article>
        <article class="cartao">
          <h3>Iris Chiba</h3>
          <p>Sócia do Kyosei. <Pendente nota="papel no box e texto de apresentação" /></p>
        </article>
      </div>
      </div>
      </div>
    </div>
  </section>

  <section class="secao secao--escura secao--curva" style="margin-top:clamp(16px,2vw,24px)">
    <div class="miolo nome-kyosei">
      <p class="kanji" lang="ja" aria-hidden="true">共生</p>
      <div>
        <p class="olho">O nome <Pendente nota="significado com os sócios" /></p>
        <blockquote>Kyosei (共生): viver e trabalhar juntos pelo bem comum.</blockquote>
        <p class="chamada" style="margin-top:20px">
          É um conceito japonês e é o jeito como a gente pensa o box. O esforço é de cada um, o resto é coletivo:
          a turma espera o último terminar, comemora a primeira vez de alguém e se encontra fora do box também.
        </p>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="miolo colagem">
      <div class="colagem__texto prosa">
        <p class="olho">Comunidade</p>
        <h2>A conversa continua fora da aula</h2>
        <p>A comunidade do Kyosei no WhatsApp tem três grupos:</p>
        <ul class="lista-check">
          <li><span><strong>Anúncios:</strong> eventos, mudanças de horário e avisos do box.</span></li>
          <li><span><strong>Fotos:</strong> os registros das aulas e dos eventos.</span></li>
          <li><span><strong>Geral:</strong> a conversa da turma.</span></li>
        </ul>
      </div>
      <div class="colagem__fotos">
        <Foto class="colagem__grande" src="/fotos/turma-wall-ball.webp" alt="Turma fazendo wall ball na parede do box" proporcao="4 / 5" posicao="50% 40%" />
        <Foto class="colagem__pequena" src="/fotos/aluna-barra.webp" alt="Aluna sustentando a barra acima da cabeça, com a turma ao fundo" proporcao="3 / 4" posicao="50% 30%" />
      </div>
    </div>
  </section>

  <FaixaCta />
</Base>
