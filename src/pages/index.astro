---
import Base from "../layouts/Base.astro";
import Botao from "../components/Botao.astro";
import Foto from "../components/Foto.astro";
import Pendente from "../components/Pendente.astro";
import GradeAulas from "../components/GradeAulas.astro";
import CartaoEvento from "../components/CartaoEvento.astro";
import Mapa from "../components/Mapa.astro";
import FaixaCta from "../components/FaixaCta.astro";
import IconeWhatsapp from "../components/IconeWhatsapp.astro";
import Selo from "../components/Selo.astro";
import Beneficios from "../components/Beneficios.astro";
import planos from "../data/planos.json";
import { site, agendarUrl, whatsappUrl, comunidadeUrl, enderecoCompleto } from "../lib/site";
import { eventosSeparados } from "../lib/eventos";

const { proximos } = await eventosSeparados();
const destaques = proximos.slice(0, 2);
const r = site.avaliacaoGoogle;

// Estrutura da aula: a mesma da página Metodologia.
const partesAula = [
  { nome: "Aquecimento", texto: "Mobilidade e movimentos leves para preparar o corpo.", foto: "/fotos/alongamento-dupla.webp", posicao: "50% 45%" },
  { nome: "Técnica", texto: "O coach explica o treino no quadro, demonstra e corrige o movimento, sem pressa.", foto: "/fotos/coach-quadro.webp", posicao: "50% 42%" },
  { nome: "Treino do dia", texto: "O WOD, adaptado ao seu nível: carga, repetições e tempo sob medida.", foto: "/fotos/aluna-barra.webp", posicao: "50% 30%" },
  { nome: "Desaquecimento", texto: "Alongamento, respiração e aquela conversa com a turma.", foto: "/fotos/desaquecimento.webp", posicao: "50% 60%" },
];
---
<Base
  titulo="CrossFit Kyosei | CrossFit no Cambuí, Campinas"
  semSufixo
  descricao="CrossFit no Cambuí, em Campinas, para quem quer começar ou treinar com constância. Aulas para todos os níveis, coach do seu lado e aula experimental. Wellhub e Totalpass."
>
  <!-- 1. Herói -->
  <section class="heroi">
    <div class="heroi__ondas" aria-hidden="true"></div>
    <svg class="heroi__nuvem heroi__nuvem--fundo" aria-hidden="true"><use href="#k-nuvem" /></svg>

    <div class="miolo heroi__grade">
      <div class="heroi__texto">
        <p class="olho">CrossFit no Cambuí, Campinas</p>
        <h1>Força, técnica e <em>gente junta.</em></h1>
        <p class="chamada">Para quem quer começar, voltar a se mexer ou treinar com constância. Você não precisa ser atleta: o coach adapta tudo ao seu ritmo.</p>
        <div class="acoes">
          <Botao href={agendarUrl} evento="agendar">Agendar aula experimental</Botao>
          <Botao href="/horarios-e-planos" variante="fantasma" evento="precos">Horários e planos</Botao>
        </div>
      </div>

      <div class="heroi__arte">
        <div class="heroi__sol">
          <Foto class="heroi__foto" src="/fotos/aula-agachamento.webp" alt="Lucas Chiba demonstrando o agachamento para um aluno, com a turma em volta, no box" proporcao="1 / 1" posicao="50% 78%" carregar="eager" />
        </div>
        <svg class="heroi__galho" aria-hidden="true"><use href="#k-galho" /></svg>
        <svg class="heroi__nuvem heroi__nuvem--a" aria-hidden="true"><use href="#k-nuvem" /></svg>
        <svg class="heroi__nuvem heroi__nuvem--b" aria-hidden="true"><use href="#k-nuvem" /></svg>

        <Selo class="heroi__selo heroi__selo--1" href={agendarUrl} rotulo="Aula" sub="experimental" icone="agenda" evento="agendar" giro={-8} />
        <Selo class="heroi__selo heroi__selo--2" href="/horarios-e-planos" rotulo="Horários" sub="e planos" icone="relogio" evento="precos" giro={6} />
        <Selo class="heroi__selo heroi__selo--3" href="/eventos" rotulo="Eventos" sub="e clínicas" icone="lanterna" evento="eventos" giro={9} />
        <Selo class="heroi__selo heroi__selo--4" href="/horarios-e-planos#parcerias" rotulo="Parceiros" sub="Wellhub · Totalpass" icone="aperto" evento="parceiros" giro={-5} />
        <Selo class="heroi__selo heroi__selo--5" href={comunidadeUrl} rotulo="Comunidade" sub="no WhatsApp" icone="conversa" evento="comunidade" giro={4} />

        <a class="heroi__nota" href={site.links.googleAvaliacoes} target="_blank" rel="noopener" data-evento="avaliacoes">
          <span class="estrelas" aria-hidden="true">★★★★★</span>
          <strong>{r.nota}</strong> no Google · {r.total} avaliações
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Para quem é -->
  <section class="secao">
    <div class="miolo colagem">
      <div class="colagem__fotos">
        <Foto class="colagem__grande" src="/fotos/coach-ajuda-aluna.webp" alt="Coach orientando uma aluna durante o treino" proporcao="4 / 5" posicao="50% 35%" />
        <Foto class="colagem__pequena" src="/fotos/aluna-medicine-ball.webp" alt="Aluna sorrindo, sentada com uma medicine ball" proporcao="3 / 4" posicao="50% 40%" />
        <svg class="colagem__flor" aria-hidden="true"><use href="#k-flor" /></svg>
      </div>
      <div class="colagem__texto">
        <p class="olho">Para quem é</p>
        <h2>Você não precisa estar em forma para começar.</h2>
        <p class="chamada">Muita gente começa no Kyosei sem nunca ter feito CrossFit. O treino é o mesmo para todo mundo, e o coach ajusta carga, repetições e movimentos para cada pessoa.</p>
        <ul class="lista-check">
          <li>Nunca treinou, ou está parado há um tempo</li>
          <li>Quer mais disposição e menos dor no dia a dia</li>
          <li>Prefere treinar acompanhado a treinar sozinho</li>
          <li>Busca constância, não competição</li>
        </ul>
        <div class="acoes">
          <Botao href={agendarUrl} evento="agendar">Agendar aula experimental</Botao>
          <a class="link-seta" href="/primeira-aula">Como é a primeira aula</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Como é a aula -->
  <section class="secao secao--sem-topo">
    <div class="miolo">
      <div class="cabeca-secao">
        <div>
          <p class="olho">Como é a aula</p>
          <h2>Uma hora, quatro partes.</h2>
        </div>
        <p class="cabeca-secao__nota">Cada aula tem coach o tempo todo e uma estrutura que se repete. Assim você sabe o que esperar desde o primeiro dia.</p>
      </div>
      <ol class="partes">
        {partesAula.map((p, i) => (
          <li class="parte revelar">
            <Foto class="parte__foto" src={p.foto} alt="" proporcao="4 / 3" posicao={p.posicao} />
            <div class="parte__texto">
              <span class="parte__num">0{i + 1}</span>
              <h3>{p.nome}</h3>
              <p>{p.texto}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="link-seta" href="/metodologia">Entenda a metodologia</a>
    </div>
  </section>

  <!-- 4. Horários -->
  <section class="secao secao--areia secao--curva">
    <div class="miolo duas-colunas">
      <div>
        <p class="olho">Horários</p>
        <h2>Antes do trabalho, no almoço ou no fim do dia.</h2>
        <p class="chamada" style="margin-top:20px">Sete horários de segunda a sexta e aulões no sábado. Em feriado tem aulão às 9h30.</p>
        <div class="acoes">
          <Botao href={agendarUrl} evento="agendar">Reservar um horário</Botao>
          <Botao href="/horarios-e-planos" variante="fantasma" evento="precos">Ver planos</Botao>
        </div>
      </div>
      <GradeAulas />
    </div>
  </section>

  <!-- 5. Primeira aula em três passos -->
  <section class="secao">
    <div class="miolo">
      <div class="cabeca-secao">
        <div>
          <p class="olho">Sua primeira aula <Pendente nota="validar o processo com o box" /></p>
          <h2>Três passos até o primeiro treino.</h2>
        </div>
        <a class="link-seta" href="/primeira-aula">Passo a passo completo</a>
      </div>
      <ol class="trajeto">
        <li>
          <h3>Agende</h3>
          <p>Escolha um horário e reserve pelo app do box ou pelo WhatsApp. Treina pelo Wellhub ou Totalpass? Avise na reserva.</p>
        </li>
        <li>
          <h3>Chegue 10 minutos antes</h3>
          <p>Venha com roupa confortável, tênis e garrafa de água. O coach vai perguntar sobre seu histórico e lesões.</p>
        </li>
        <li>
          <h3>Treine no seu ritmo</h3>
          <p>Você faz a aula com a turma, com o treino adaptado para você. No fim, a gente tira dúvidas e mostra os planos.</p>
        </li>
      </ol>
      <div class="acoes"><Botao href={agendarUrl} evento="agendar">Agendar aula experimental</Botao></div>
    </div>
  </section>

  <!-- 6. Coaches -->
  <section class="secao secao--escura secao--curva">
    <div class="miolo coaches-home">
      <div class="coaches-home__texto">
        <p class="olho">Coaches</p>
        <h2>Quem dá a aula é dono do box.</h2>
        <p class="chamada" style="margin-top:20px">Lucas Chiba, head coach CrossFit Level 3, é sócio do Kyosei e está na aula. Todos os coaches são certificados CrossFit.</p>
        <a class="link-seta" href="/coaches">Conheça os coaches</a>
      </div>
      <a class="retrato retrato--1" href="/coaches#lucas-chiba">
        <Foto src="/fotos/coach-lucas-chiba.webp" alt="Lucas Chiba, sócio e head coach do CrossFit Kyosei" proporcao="4 / 5" posicao="50% 25%" />
        <span class="retrato__nome"><strong>Lucas Chiba</strong> Sócio e head coach · CF-L3</span>
      </a>
      <a class="retrato retrato--2" href="/coaches#stella-mazotti">
        <Foto src="/fotos/coach-stella-mazotti.webp" alt="Stella Mazotti Magalhães, coach do CrossFit Kyosei" proporcao="4 / 5" posicao="50% 20%" />
        <span class="retrato__nome"><strong>Stella Mazotti</strong> Coach · CF-L1 · Educação Física</span>
      </a>
    </div>
  </section>

  <!-- 7. Planos -->
  <section class="secao">
    <div class="miolo">
      <div class="cabeca-secao">
        <div>
          <p class="olho">Planos <Pendente nota="aguardando tabela de preços" /></p>
          <h2>Escolha como treinar.</h2>
        </div>
        <a class="link-seta" href="/horarios-e-planos#planos" data-evento="precos">Ver valores</a>
      </div>
      <ul class="lista-planos">
        {planos.planos.map((p) => (
          <li>
            <a href="/horarios-e-planos#planos" data-evento="precos">
              <span class="lista-planos__nome">{p.nome}</span>
              <span class="lista-planos__estrela" aria-hidden="true">✶</span>
              <span class="lista-planos__detalhe">{p.detalhe}</span>
              <span class="lista-planos__preco">{p.preco ? `${p.preco}${p.periodo}` : "Consulte"}</span>
            </a>
          </li>
        ))}
        <li>
          <a href="/horarios-e-planos#parcerias" data-evento="parceiros">
            <span class="lista-planos__nome">Wellhub · Totalpass</span>
            <span class="lista-planos__estrela" aria-hidden="true">✶</span>
            <span class="lista-planos__detalhe">Wellhub a partir do Gold</span>
            <span class="lista-planos__preco">Pelo app</span>
          </a>
        </li>
      </ul>

      <div class="beneficios-home">
        <div>
          <p class="olho">Benefícios da matrícula</p>
          <h3>Quem é aluno também ganha desconto em parceiros.</h3>
          <a class="link-seta" href="/horarios-e-planos#beneficios">Ver benefícios</a>
        </div>
        <Beneficios compacto />
      </div>
    </div>
  </section>

  <!-- 8. Comunidade e eventos -->
  <section class="secao secao--areia secao--curva">
    <div class="miolo">
      <div class="cabeca-secao">
        <div>
          <p class="olho">Comunidade</p>
          <h2>A turma é o que faz você voltar.</h2>
        </div>
        <p class="cabeca-secao__nota">Na comunidade do WhatsApp tem grupo de anúncios, de fotos e de conversa geral. É lá que os eventos saem primeiro.</p>
      </div>
      <div class="mosaico">
        <Foto class="mosaico__a" src="/fotos/turma-completa.webp" alt="Turma do Kyosei reunida no box, sorrindo para a foto" proporcao="auto" posicao="50% 60%" />
        <Foto class="mosaico__b" src="/fotos/turma-wall-ball.webp" alt="Turma fazendo wall ball na parede do box" proporcao="auto" posicao="50% 40%" />
        <Foto class="mosaico__c" src="/fotos/turma-parada-de-maos.webp" alt="Aluna ajudando a colega na parada de mãos" proporcao="auto" posicao="50% 40%" />
        <Foto class="mosaico__d" src="/fotos/aluna-halter.webp" alt="Aluna treinando com halter" proporcao="auto" posicao="50% 30%" />
        <Foto class="mosaico__e" src="/fotos/alongamento-dupla.webp" alt="Dupla se alongando e conversando" proporcao="auto" posicao="50% 50%" />
      </div>

      <div class="comunidade-rodape">
        <div class="agenda-curta">
          <div class="agenda-curta__topo">
            <h3>Na agenda</h3>
            <a class="link-seta" href="/eventos" data-evento="eventos">Todos os eventos</a>
          </div>
          {destaques.length ? (
            <ul class="agenda-lista">{destaques.map((e) => <li><CartaoEvento evento={e} compacto /></li>)}</ul>
          ) : (
            <p class="agenda-vazia">Nenhum evento marcado agora. Os anúncios saem primeiro na comunidade.</p>
          )}
        </div>
        <div class="comunidade-cta">
          <h3>Comunidade no WhatsApp</h3>
          <p>Três grupos para quem treina ou quer conhecer a turma antes:</p>
          <ul class="grupos">
            <li><strong>Anúncios</strong> eventos e avisos</li>
            <li><strong>Fotos</strong> registros das aulas</li>
            <li><strong>Geral</strong> a conversa da turma</li>
          </ul>
          <Botao href={comunidadeUrl} variante="whatsapp" evento="comunidade"><IconeWhatsapp /> Entrar na comunidade</Botao>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Onde estamos -->
  <section class="secao">
    <div class="miolo duas-colunas">
      <div>
        <p class="olho">Onde estamos</p>
        <h2>Na General Osório, no Cambuí.</h2>
        <dl class="dados" style="margin-top:32px">
          <div><dt>Endereço</dt><dd>{enderecoCompleto}</dd></div>
          <div><dt>WhatsApp</dt><dd><a href={whatsappUrl()} target="_blank" rel="noopener" data-evento="whatsapp">{site.telefone}</a></dd></div>
          <div>
            <dt>Funcionamento</dt>
            <dd>{site.funcionamento.map((f) => <>{f.dias}: {f.horas}{"pendente" in f && f.pendente && <Pendente />}<br /></>)}</dd>
          </div>
        </dl>
        <div class="acoes"><a class="link-seta" href="/contato">Como chegar</a></div>
      </div>
      <Mapa />
    </div>
  </section>

  <FaixaCta />
</Base>
