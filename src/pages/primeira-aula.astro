---
import Base from "../layouts/Base.astro";
import Topo from "../components/Topo.astro";
import Botao from "../components/Botao.astro";
import Pendente from "../components/Pendente.astro";
import Foto from "../components/Foto.astro";
import FaixaCta from "../components/FaixaCta.astro";
import IconeWhatsapp from "../components/IconeWhatsapp.astro";
import { agendarUrl, whatsappUrl, site } from "../lib/site";
---
<Base
  titulo="Sua primeira aula de CrossFit"
  descricao="Como é a primeira aula de CrossFit no Kyosei, em Campinas: como agendar, o que levar, o que esperar e como adaptamos o treino para iniciantes."
>
  <Topo
    olho="Para quem está começando"
    titulo="Sua primeira aula, passo a passo"
    chamada="Nunca fez CrossFit? Muita gente começa assim. Veja como funciona antes de chegar."
  >
    <div class="acoes"><Botao href={agendarUrl} evento="agendar">Agendar aula experimental</Botao></div>
  </Topo>

  <section class="secao">
    <div class="miolo duas-colunas">
      <div>
        <p class="olho">Como funciona <Pendente nota="validar o processo com o box" /></p>
        <ol class="passos">
          <li class="passo"><div><h3>Agende o horário</h3><p>Escolha uma aula na grade e reserve pelo app de agendamento ou pelo WhatsApp. Se treina pelo Wellhub ou Totalpass, avise na reserva.</p></div></li>
          <li class="passo"><div><h3>Chegue 10 minutos antes</h3><p>Dá tempo de conhecer o espaço, guardar suas coisas e conversar com o coach.</p></div></li>
          <li class="passo"><div><h3>Conte seu histórico</h3><p>O coach pergunta sobre lesões, dores e o que você já praticou. É assim que o treino é ajustado para você.</p></div></li>
          <li class="passo"><div><h3>Aquecimento e técnica</h3><p>Toda aula começa aquecendo o corpo e treinando os movimentos do dia, com correção de perto.</p></div></li>
          <li class="passo"><div><h3>O treino do dia, no seu nível</h3><p>Todo mundo faz o mesmo treino, com carga, repetições e movimentos adaptados. Na primeira aula, o objetivo é aprender, não bater recorde.</p></div></li>
          <li class="passo"><div><h3>Desaquecimento e conversa</h3><p>No fim, a gente alonga, tira dúvidas e mostra os planos, se você quiser continuar.</p></div></li>
        </ol>
      </div>
      <div class="colagem__fotos" style="position:sticky;top:calc(var(--cabecalho-h) + 24px)">
        <Foto class="colagem__grande" src="/fotos/aula-agachamento.webp" alt="Lucas Chiba demonstrando o agachamento para um aluno no box" proporcao="4 / 5" posicao="50% 70%" />
        <Foto class="colagem__pequena" src="/fotos/aluna-halter.webp" alt="Aluna treinando com halter" proporcao="3 / 4" posicao="50% 30%" />
      </div>
    </div>
  </section>

  <section class="secao secao--areia secao--curva">
    <div class="miolo levar-esperar">
      <div>
        <p class="olho">O que levar</p>
        <h2>Pouca coisa.</h2>
        <ul class="itens-levar">
          <li><svg aria-hidden="true"><use href="#k-ic-camiseta" /></svg><strong>Roupa confortável</strong><span>Que deixe você se mexer à vontade</span></li>
          <li><svg aria-hidden="true"><use href="#k-ic-tenis" /></svg><strong>Tênis</strong><span>O que você já usa para treinar ou correr</span></li>
          <li><svg aria-hidden="true"><use href="#k-ic-garrafa" /></svg><strong>Garrafa de água</strong><span>Para se hidratar durante a aula</span></li>
        </ul>
      </div>
      <div>
        <p class="olho">O que esperar</p>
        <h2>Uma aula como as outras.</h2>
        <dl class="esperar">
          <div><dt>Cerca de uma hora</dt><dd>Em turma, com coach do começo ao fim.</dd></div>
          <div><dt>Movimentos adaptados</dt><dd>Ninguém precisa saber fazer nada antes.</dd></div>
          <div><dt>Cansaço bom</dt><dd>E, talvez, alguma dor muscular nos dias seguintes. É normal.</dd></div>
          <div><dt>Gente como você</dt><dd>Muita gente da turma também começou do zero.</dd></div>
        </dl>
      </div>
    </div>
    <div class="miolo duvida">
      <p>Ficou alguma dúvida antes de vir?</p>
      <div class="acoes">
        <Botao href={whatsappUrl("Olá! Nunca fiz CrossFit e tenho uma dúvida antes da primeira aula.")} variante="whatsapp" evento="whatsapp"><IconeWhatsapp /> Perguntar no WhatsApp</Botao>
        <a class="link-seta" href="/faq">Perguntas frequentes</a>
      </div>
    </div>
  </section>

  <FaixaCta titulo="Pronto para a primeira?" texto={`Aulas de segunda a sábado na ${site.endereco.rua}, no Cambuí.`} />
</Base>
