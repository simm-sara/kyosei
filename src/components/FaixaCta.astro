---
import Botao from "./Botao.astro";
import IconeWhatsapp from "./IconeWhatsapp.astro";
import Foto from "./Foto.astro";
import { agendarUrl, whatsappUrl } from "../lib/site";
interface Props { titulo?: string; texto?: string; foto?: string }
const {
  titulo = "Sua primeira aula começa aqui.",
  texto = "Agende uma aula experimental e conheça o box, os coaches e a turma.",
  foto = "/fotos/primeira-aula.webp",
} = Astro.props;
---
<section class="secao cta-final">
  <div class="miolo">
    <div class="cta-final__cartao">
      <svg class="cta-final__nuvem" aria-hidden="true"><use href="#k-nuvem" /></svg>
      <div class="cta-final__texto">
        <h2>{titulo}</h2>
        <p class="chamada">{texto}</p>
        <div class="acoes">
          <Botao href={agendarUrl} evento="agendar">Agendar aula</Botao>
          <Botao href={whatsappUrl()} variante="fantasma" evento="whatsapp"><IconeWhatsapp /> WhatsApp</Botao>
        </div>
      </div>
      <Foto class="cta-final__foto" src={foto} alt="Coach e aluna conversando durante a primeira aula" proporcao="auto" posicao="50% 30%" />
    </div>
  </div>
</section>
