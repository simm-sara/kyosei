---
import Logo from "./Logo.astro";
import Pendente from "./Pendente.astro";
import LogoCrossFit from "./LogoCrossFit.astro";
import { site, enderecoCompleto, instagramUrl, whatsappUrl, comunidadeUrl, agendarUrl, url } from "../lib/site";
const ano = new Date().getFullYear();
---
<footer class="rodape">
  <div class="miolo rodape__grade">
    <div class="rodape__marca">
      <a href={url("/")} aria-label="CrossFit Kyosei, página inicial"><Logo /></a>
      <p>Box afiliado CrossFit no Cambuí, em Campinas. Desde {site.inauguracao}.</p>
      <p class="rodape__afiliado"><span>Box afiliado oficial</span><LogoCrossFit /></p>
    </div>

    <div>
      <h2 class="rodape__titulo">Onde</h2>
      <address>
        <a href={site.links.googleMaps} target="_blank" rel="noopener" data-evento="mapa">{enderecoCompleto}</a><br />
        <a href={whatsappUrl()} target="_blank" rel="noopener" data-evento="whatsapp">{site.telefone}</a> (WhatsApp)<br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </div>

    <div>
      <h2 class="rodape__titulo">Funcionamento</h2>
      <dl class="rodape__horas">
        {site.funcionamento.map((f) => (<><dt>{f.dias}</dt><dd>{f.horas}{"pendente" in f && f.pendente && <Pendente />}</dd></>))}
      </dl>
    </div>

    <div>
      <h2 class="rodape__titulo">Box</h2>
      <ul class="rodape__links">
        <li><a href={url("/metodologia")}>Metodologia</a></li>
        <li><a href={url("/boas-praticas")}>Boas práticas</a></li>
        <li><a href={url("/armario")}>Armário</a></li>
        <li><a href={url("/faq")}>Perguntas frequentes</a></li>
        <li><a href={agendarUrl} target="_blank" rel="noopener" data-evento="agendar">Agendar aula</a></li>
        <li><a href={comunidadeUrl} target="_blank" rel="noopener" data-evento="comunidade">Comunidade no WhatsApp</a></li>
        <li><a href={instagramUrl} target="_blank" rel="noopener" data-evento="instagram">Instagram @{site.instagram}</a></li>
      </ul>
    </div>
  </div>

  <div class="miolo rodape__base">
    <p>© {ano} CrossFit Kyosei. CrossFit® é marca registrada da CrossFit, LLC, usada aqui sob licença de afiliado.</p>
    <p><a href={url("/privacidade")}>Privacidade</a> · <button type="button" class="link-botao" data-abrir-cookies>Preferências de cookies</button></p>
  </div>
</footer>
